{
  "book": "箴言",
  "version": "和合本",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        { "verse": 1, "text": "以色列王大卫儿子所罗门的箴言：" },
        { "verse": 2, "text": "要使人晓得智慧和训诲，分辨通达的言语，" },
        { "verse": 3, "text": "使人处事领受智慧、仁义、公平、正直的训诲，" },
        { "verse": 7, "text": "敬畏耶和华是知识的开端，愚妄人藐视智慧和训诲。" }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        { "verse": 1, "text": "我儿，你若领受我的言语，存记我的命令，" },
        { "verse": 5, "text": "你就明白敬畏耶和华，得以认识神。" },
        { "verse": 6, "text": "因为耶和华赐人智慧，知识和聪明都由他口而出。" }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        { "verse": 1, "text": "我儿，不要忘记我的法则（或作"指教"），你心要谨守我的诫命。" },
        { "verse": 5, "text": "你要专心仰赖耶和华，不可倚靠自己的聪明，" },
        { "verse": 6, "text": "在你一切所行的事上，都要认定他，他必指引你的路。" }
      ]
    },
    {
      "chapter": 4,
      "verses": [
        { "verse": 1, "text": "众子啊，要听父亲的教训，留心得知聪明。" },
        { "verse": 7, "text": "智慧为首，所以要得智慧，在你一切所得之内必得聪明（或作"用你一切所得的去换聪明"）。" }
      ]
    },
    {
      "chapter": 5,
      "verses": [
        { "verse": 1, "text": "我儿，要留心我智慧的话语，侧耳听我聪明的言词，" }
      ]
    },
    {
      "chapter": 6,
      "verses": [
        { "verse": 6, "text": "懒惰人哪，你去察看蚂蚁的动作，就可得智慧。" }
      ]
    },
    {
      "chapter": 7,
      "verses": [
        { "verse": 1, "text": "我儿，你要遵守我的言语，将我的命令存记在心。" }
      ]
    },
    {
      "chapter": 8,
      "verses": [
        { "verse": 1, "text": "智慧岂不呼叫？聪明岂不发声？" }
      ]
    },
    {
      "chapter": 9,
      "verses": [
        { "verse": 10, "text": "敬畏耶和华是智慧的开端，认识至圣者便是聪明！" }
      ]
    },
    {
      "chapter": 10,
      "verses": [
        { "verse": 1, "text": "所罗门的箴言：智慧之子使父亲欢乐；愚昧之子叫母亲担忧。" }
      ]
    },
    {
      "chapter": 11,
      "verses": [
        { "verse": 2, "text": "骄傲来，羞耻也来；谦逊人却有智慧。" }
      ]
    },
    {
      "chapter": 12,
      "verses": [
        { "verse": 1, "text": "喜爱管教的，就是喜爱知识；恨恶责备的，却是畜类。" }
      ]
    },
    {
      "chapter": 13,
      "verses": [
        { "verse": 20, "text": "与智慧人同行的，必得智慧；和愚昧人作伴的，必受亏损。" }
      ]
    },
    {
      "chapter": 14,
      "verses": [
        { "verse": 12, "text": "有一条路，人以为正，至终成为死亡之路。" }
      ]
    },
    {
      "chapter": 15,
      "verses": [
        { "verse": 1, "text": "回答柔和，使怒消退；言语暴戾，触动怒气。" }
      ]
    },
    {
      "chapter": 16,
      "verses": [
        { "verse": 3, "text": "你所做的，要交托耶和华，你所谋的，就必成立。" },
        { "verse": 9, "text": "人心筹算自己的道路，惟耶和华指引他的脚步。" }
      ]
    },
    {
      "chapter": 17,
      "verses": [
        { "verse": 17, "text": "朋友乃时常亲爱，弟兄为患难而生。" },
        { "verse": 22, "text": "喜乐的心乃是良药；忧伤的灵使骨枯干。" }
      ]
    },
    {
      "chapter": 18,
      "verses": [
        { "verse": 10, "text": "耶和华的名是坚固台；义人奔入便得安稳。" }
      ]
    },
    {
      "chapter": 19,
      "verses": [
        { "verse": 21, "text": "人心多有计谋，惟有耶和华的筹算才能立定。" }
      ]
    },
    {
      "chapter": 20,
      "verses": [
        { "verse": 7, "text": "行为纯正的义人，他的子孙是有福的！" }
      ]
    },
    {
      "chapter": 21,
      "verses": [
        { "verse": 3, "text": "行仁义公平比献祭更蒙耶和华悦纳。" }
      ]
    },
    {
      "chapter": 22,
      "verses": [
        { "verse": 1, "text": "美名胜过大财，恩宠强如金银。" },
        { "verse": 6, "text": "教养孩童，使他走当行的道，就是到老他也不偏离。" }
      ]
    },
    {
      "chapter": 23,
      "verses": [
        { "verse": 17, "text": "你心中不要嫉妒罪人，只要终日敬畏耶和华。" }
      ]
    },
    {
      "chapter": 24,
      "verses": [
        { "verse": 3, "text": "房屋因智慧建造，又因聪明立稳；" },
        { "verse": 16, "text": "因为义人虽七次跌倒，仍必兴起；恶人却被祸患倾倒。" }
      ]
    },
    {
      "chapter": 25,
      "verses": [
        { "verse": 11, "text": "一句话说得合宜，就如金苹果在银网子里。" }
      ]
    },
    {
      "chapter": 26,
      "verses": [
        { "verse": 20, "text": "火缺了柴就必熄灭；无人传舌，争竞便止息。" }
      ]
    },
    {
      "chapter": 27,
      "verses": [
        { "verse": 1, "text": "不要为明日自夸，因为一日要生何事，你尚且不能知道。" },
        { "verse": 17, "text": "铁磨铁，磨出刃来；朋友相感（原文作"磨朋友的脸"）也是如此。" }
      ]
    },
    {
      "chapter": 28,
      "verses": [
        { "verse": 1, "text": "恶人虽无人追赶也逃跑；义人却胆壮像狮子。" },
        { "verse": 13, "text": "遮掩自己罪过的，必不亨通；承认离弃罪过的，必蒙怜恤。" }
      ]
    },
    {
      "chapter": 29,
      "verses": [
        { "verse": 18, "text": "没有异象（或作"默示"），民就放肆；惟遵守律法的，便为有福。" },
        { "verse": 25, "text": "惧怕人的，陷入网罗；惟有倚靠耶和华的，必得安稳。" }
      ]
    },
    {
      "chapter": 30,
      "verses": [
        { "verse": 5, "text": "神的言语句句都是炼净的，投靠他的，他便作他们的盾牌。" }
      ]
    },
    {
      "chapter": 31,
      "verses": [
        { "verse": 25, "text": "能力和威仪是她的衣服，她想到日后的景况就喜笑。" },
        { "verse": 30, "text": "艳丽是虚假的，美容是虚浮的；惟敬畏耶和华的妇女必得称赞！" }
      ]
    }
  ]
}
